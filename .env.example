# Variáveis do apps/web. Local: `pnpm env:local` gera apps/web/.env.local a partir do Supabase local do remoa-backend.
# Produção (Vercel › Settings › Environment Variables): as mesmas chaves com os valores de produção.
# NEXT_PUBLIC_* entram no bundle no build: mudou na Vercel, faça um redeploy.

# --- Obrigatórias ---
# Supabase › Project Settings › API (URL e chave anon). Sem elas o middleware falha em toda página.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública da API (remoa-backend). Sem ela o web chama http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
# D-537: same value as PROXY_SHARED_SECRET in the API. Server-only (never NEXT_PUBLIC_): server components/actions send the
# browser's IP as x-remoa-client-ip with this secret. The IP is read from x-forwarded-for, which Vercel sets (overwrites) itself;
# self-hosting Next behind your own proxy, make that proxy overwrite x-forwarded-for, or a browser can choose its IP.
PROXY_SHARED_SECRET=local-dev-only-proxy-secret

# --- Site e landing (F16, D-233) ---
# Canonical, Open Graph, sitemap, robots e links (D-915). Única fonte do domínio no web. Vazio: http://localhost:3000;
# no build de produção da Vercel (VERCEL_ENV=production) vazio falha o build. Produção: https://remoa.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# waitlist: o CTA da landing leva à lista de espera; open: leva ao /cadastro.
NEXT_PUBLIC_LAUNCH_PHASE=waitlist
# 1: mostra a oferta de fundador nos planos da landing.
NEXT_PUBLIC_BETA_FOUNDER=0
# 1: mostra os selos "Revisado por médico" (só quando houver conteúdo aprovado no F10).
NEXT_PUBLIC_APPROVED_CONTENT=0

# --- Blog e páginas legais (G19 · F27, D-914) — lidos só no servidor por src/lib/env/legal.ts ---
# Mesmo valor do REVALIDATE_SECRET da API (32+ caracteres): protege POST /api/revalidate.
REVALIDATE_SECRET=
# Opcional: token do Google Search Console (meta google-site-verification).
GOOGLE_SITE_VERIFICATION=

# --- Cache (G21/F29 T6, docs/perf/CACHE.md) — lidos por src/lib/cache ---
# Subir CACHE_VERSION troca todas as chaves do Data Cache do web (padrão 1); CACHE_DISABLED=1 ignora o cache (depuração).
# POST /api/revalidate (alias /api/internal/revalidate) limpa tags com o REVALIDATE_SECRET acima.
CACHE_VERSION=1
CACHE_DISABLED=

# --- Opcionais ---
# 1: botão "Entrar com Google" (exige o provedor Google ligado no Supabase).
NEXT_PUBLIC_AUTH_GOOGLE=0
# Versão mostrada no suporte e nos eventos locais.
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Só desenvolvimento (ignoradas em produção) ---
# 1: toasts de erro da API na tela (só com NODE_ENV=development).
NEXT_PUBLIC_API_DEBUG=0
# 1: painel admin com dados falsos, sem API (nunca em produção).
ADMIN_MOCKS=0
# Pasta do build; só para medir desempenho sem pisar no .next do dev server.
# NEXT_DIST_DIR=.next


NEXT_PUBLIC_SUPABASE_URL=https://hlqkuhdauphoymdlvzad.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eCIS3YhzNsJmm4xubbkUVw_9rXBTvB-
# Desempenho (G21/F29 FR-3), só no servidor: cada chamada à API feita pelo Next (serverApi, Server Actions) vira uma linha JSON
# com requestId, ms e o Server-Timing da API (db, queries, ext, app). Sempre acima de PERF_SLOW_API_MS (padrão 800); todas com PERF_LOG_API=1.
PERF_SLOW_API_MS=800
PERF_LOG_API=
